# Copy to .env and fill in your key. .env is git-ignored.

# Required - get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional - overrides the default model used by the review agents
# Any LiteLLM OpenRouter id works, e.g. openrouter/anthropic/claude-sonnet-5
# AGT_REVIEW_MODEL=openrouter/moonshotai/kimi-k2.6
